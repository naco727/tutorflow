{
  "name": "tutorflow",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "node --test tests/workspace.test.cjs tests/availability.test.cjs tests/account-admin.test.mjs",
    "test:rules": "firebase emulators:exec --project demo-tutorflow --only firestore \"node --test tests/firestore.rules.test.cjs\"",
    "test:auth": "firebase emulators:exec --project demo-tutorflow --only auth,firestore \"node --test tests/auth.emulator.test.cjs\"",
    "emulators": "firebase emulators:start --project demo-tutorflow --only auth,firestore",
    "build": "node tests/check-scripts.cjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase": "^11.10.0",
    "firebase-tools": "^15.0.0"
  }
}
